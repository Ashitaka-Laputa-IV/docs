# LangGraph 文档示例所需的环境变量
#
# 用法: 复制本文件为仓库根目录的 .env, 再填入真实值
#   cp .env.example .env
#
# .env 已被 .gitignore 忽略(不会提交); 本文件只放占位符, 会被提交。

# main: chat model —— ipynbs/ 与 summaries-and-demos/demos/ 统一使用
#       init_chat_model("deepseek:deepseek-chat")
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 备用: embedding —— 硅基流动, 模型 BAAI/bge-m3, dims=1024
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# LangSmith 追踪 —— observability、studio、deploy 章节
LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_xxxxxxxxxxxx

# 以下按需开启(默认注释掉)
# LANGSMITH_TRACING=true             # observability / studio 的 demo 未设置时会自动置为 true
# LANGSMITH_PROJECT=langgraph-docs   # 追踪写入的项目名

# 仅 deploy 章节需要: 部署到 LangSmith Cloud 之后的实例地址(本地示例用不到)
# LANGSMITH_DEPLOYMENT_URL=https://your-deployment-url
